# Swift Package Manager build products
.build/
*.o
*.dSYM/

# Assembled app bundle — rebuilt from sources by build-scripts/install.sh.
# Only Info.plist is tracked; the binary and copied resources are not.
Klack.app/Contents/MacOS/
Klack.app/Contents/Resources/
Klack.app/Contents/_CodeSignature/

# Generated intermediates
AppIcon/Klack.iconset/
AppIcon/icon_1024.png

# macOS
.DS_Store

# Synthesized profiles are reproducible from generate_sounds.py and not
# committed. The three recorded packs ARE committed: they are what ships.
Resources/profiles/*
!Resources/profiles/real_clicky/
!Resources/profiles/real_creamy/
!Resources/profiles/real_thocky/

# Film / social production assets live outside the product repo
film-assets/
film-audio/
film-script.md
docs/social/

# Release artifacts are attached to GitHub Releases, not committed
*.dmg
*.zip
